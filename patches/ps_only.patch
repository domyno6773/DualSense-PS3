--- DS45Pad/src/padldd.c	2026-10-10 21:51:15.038267695 +0200
+++ build_psonly/padldd.c	2026-10-11 16:30:39.168849680 +0200
@@ -297,6 +297,33 @@
 	for (i = 0; i < DS45_PAD_LEN; i++)
 		button[i] = 0;
 
+	/* --- PS-only mode ---------------------------------------------------- */
+	/* The real controller keeps talking to the console on its own port, so
+	 * copying every control onto the virtual pad makes the XMB react twice.
+	 * Here the virtual pad carries the PS button and nothing else: sticks at
+	 * centre (zero would be full deflection), pressure at rest, sensors at
+	 * their neutral value. */
+	if (g_cfg.ps_only) {
+		if (b & DS45_B_PS) {
+			ldd |= DS45_CTRL_LDD_PS;
+			d1  |= DS45_CTRL_PS;
+		}
+
+		button[DS45_BTN_LDD]            = ldd;
+		button[DS45_BTN_DIGITAL1]       = d1;
+		button[DS45_BTN_DIGITAL2]       = 0;
+		button[DS45_BTN_ANALOG_LEFT_X]  = DS45_STICK_CENTER;
+		button[DS45_BTN_ANALOG_LEFT_Y]  = DS45_STICK_CENTER;
+		button[DS45_BTN_ANALOG_RIGHT_X] = DS45_STICK_CENTER;
+		button[DS45_BTN_ANALOG_RIGHT_Y] = DS45_STICK_CENTER;
+		button[DS45_BTN_SENSOR_X]       = DS45_SENSOR_CENTER;
+		button[DS45_BTN_SENSOR_Y]       = DS45_SENSOR_CENTER;
+		button[DS45_BTN_SENSOR_Z]       = DS45_SENSOR_CENTER;
+		button[DS45_BTN_SENSOR_G]       = DS45_SENSOR_CENTER;
+		(void)d2; (void)lx; (void)ly; (void)rx; (void)ry; (void)pad;
+		return;
+	}
+
 	/* --- digital buttons ------------------------------------------------ */
 	if (b & DS45_B_SHARE)    d1 |= DS45_CTRL_SELECT;
 	if (b & DS45_B_OPTIONS)  d1 |= DS45_CTRL_START;
